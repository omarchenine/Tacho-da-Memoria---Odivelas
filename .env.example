# ──────────────────────────────────────────────────────────────────────────────
# TACHO DA MEMÓRIA – Environment Variables for Vercel & Local
# Copy this file to .env.local for local development or set in Vercel settings.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local SQLite database (for local testing):
DATABASE_URL="file:./prisma/dev.db"
# For Vercel Production, use a PostgreSQL connection URL (e.g. Neon.tech or Supabase free tier):
# DATABASE_URL="postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Email Options for Vercel Production (Choose Option A or Option B) ──────────

# OPTION A: Resend API (RECOMMENDED FOR VERCEL - 100% Free 3,000 emails/month)
# Get a free key at https://resend.com
# RESEND_API_KEY="re_123456789..."
# RESEND_FROM="Tacho da Memória <onboarding@resend.dev>"

# OPTION B: Gmail SMTP
# Note: On Vercel, use SMTP_PORT="465" for SSL or "587" for STARTTLS.
# Use a 16-character App Password from https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="sifoomar7@gmail.com"
SMTP_PASS="ewpwbfocnbtsyxxf"
SMTP_FROM="Tacho da Memória <sifoomar7@gmail.com>"

# ── Restaurant Settings ────────────────────────────────────────────────────────
# Email address that receives new reservation notification alerts
RESTAURANT_EMAIL="sifoomar7@gmail.com"
RESTAURANT_NAME="Tacho da Memória"

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
