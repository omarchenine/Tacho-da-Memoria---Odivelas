# ──────────────────────────────────────────────────────────────────────────────
# TACHO DA MEMÓRIA – Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git!
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Prisma / SQLite) ─────────────────────────────────────────────────
# SQLite file-based database – stored locally, no server needed.
DATABASE_URL="file:./prisma/dev.db"

# ── Email (SMTP via Gmail) ────────────────────────────────────────────────────
# Use a Gmail App Password (NOT your normal Gmail password).
# How to create one:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create a new App Password (select "Mail" + "Windows Computer")
#   4. Copy the 16-character password and paste it as SMTP_PASS below.

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Tacho da Memória <your-gmail@gmail.com>"

# ── Restaurant Settings ────────────────────────────────────────────────────────
# Email where new reservation notifications are sent (can be same as SMTP_USER)
RESTAURANT_EMAIL="reservas@tachodamemoria.pt"
RESTAURANT_NAME="Tacho da Memória"

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used in email footer links. Change to your real domain in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
